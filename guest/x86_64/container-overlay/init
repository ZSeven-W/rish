#!/bin/busybox sh
# PID 1 for the interactive container initramfs used by the iOS/Android demos.
# It brings up the pseudo filesystems, installs the busybox applet links, then
# hands the serial protocol to the guest agent. The agent execs each command in
# a fresh sandbox, so the demo host re-mounts /proc per command; the mount
# points created here just need to exist.
export HOME=/root
export PATH=/usr/sbin:/usr/bin:/sbin:/bin

mkdir -p /proc /sys /dev /tmp /root

# The rootfs ships only the busybox binary; materialise the applet links
# FIRST: the mounts below (and the insmods after them) need the applets.
/bin/busybox --install -s /bin 2>/dev/null

mount -t proc proc /proc 2>/dev/null || true
mount -t sysfs sysfs /sys 2>/dev/null || true
mount -t devtmpfs devtmpfs /dev 2>/dev/null || true

# Load the root-disk drivers the pinned virt kernel ships as modules: the
# emulated machine exposes root_disk_path as a virtio-mmio block device
# (transport built in), so virtio_blk registers /dev/vda via devtmpfs as
# soon as it loads. The vfat stack follows so a plain mount -t vfat works.
# insmod failures are tolerated: the agent must still boot without a disk,
# and the host sees the missing block node in the command output.
MODULES=/lib/modules/6.18.35-0-virt
insmod "$MODULES/kernel/drivers/block/virtio_blk.ko" 2>/dev/null || true
insmod "$MODULES/kernel/fs/fat/fat.ko" 2>/dev/null || true
insmod "$MODULES/kernel/fs/nls/nls_cp437.ko" 2>/dev/null || true
insmod "$MODULES/kernel/fs/nls/nls_ascii.ko" 2>/dev/null || true
insmod "$MODULES/kernel/fs/nls/nls_utf8.ko" 2>/dev/null || true
insmod "$MODULES/kernel/fs/fat/vfat.ko" 2>/dev/null || true

# Network drivers. The emulated machine exposes a second virtio-mmio device;
# virtio_net depends on net_failover, which depends on failover (all modules
# in the pinned virt kernel). Load order matters: busybox insmod does not
# resolve dependencies. insmod failures are tolerated: the agent must still
# boot without a NIC, and the host sees the missing interface in the output.
insmod "$MODULES/kernel/net/core/failover.ko" 2>/dev/null || true
insmod "$MODULES/kernel/drivers/net/net_failover.ko" 2>/dev/null || true
insmod "$MODULES/kernel/drivers/net/virtio_net.ko" 2>/dev/null || true

# Static addressing on the emulated network: 10.0.2.0/24 with gateway and
# DNS at 10.0.2.2, the addresses the interpreter's slirp-style backend
# terminates. dhcpcd is not shipped, and static configuration needs no DHCP
# state machine on the host side; the guest just needs a route and a
# resolver, both deterministic.
ip link set eth0 up 2>/dev/null || true
ip addr add 10.0.2.15/24 dev eth0 2>/dev/null || true
ip route add default via 10.0.2.2 2>/dev/null || true
echo "nameserver 10.0.2.2" > /etc/resolv.conf 2>/dev/null || true

hostname -F /etc/hostname 2>/dev/null || true

echo RISH_X86_64_BOOT_OK
exec /usr/bin/rish-guest-agent </dev/null >/dev/null 2>/dev/ttyS0
